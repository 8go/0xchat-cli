parse_global_args() {
    log_debug "Entering parse_global_args with $# arguments"
    while (($#)); do
        case "$1" in
            -h|--help) SHOW_HELP=1 ;;
            -v|--version) SHOW_VERSION=1 ;;
            -d|--debug)
                if [[ $QUIET -eq 1 ]]; then usage_error "Cannot use --debug and --quiet together"; fi
                DEBUG=1
                ;;
            -q|--quiet)
                if [[ $DEBUG -eq 1 ]]; then usage_error "Cannot use --debug and --quiet together"; fi
                QUIET=1
                ;;
            --no-color) NO_COLOR=1 ;;
            --json) JSON=1 ;;
            --config-identities) [[ $# -ge 2 ]] || usage_error "Missing value for --config-identities"; CONFIG_IDENTITIES_PATH="$(trim "$2")"; shift ;;
            --config-contacts) [[ $# -ge 2 ]] || usage_error "Missing value for --config-contacts"; CONFIG_CONTACTS_PATH="$(trim "$2")"; shift ;;
            --config-relays) [[ $# -ge 2 ]] || usage_error "Missing value for --config-relays"; CONFIG_RELAYS_PATH="$(trim "$2")"; shift ;;
            --config-private-groups) [[ $# -ge 2 ]] || usage_error "Missing value for --config-private-groups"; CONFIG_PRIVATE_GROUPS_PATH="$(trim "$2")"; shift ;;
            --config-channels) [[ $# -ge 2 ]] || usage_error "Missing value for --config-channels"; CONFIG_CHANNELS_PATH="$(trim "$2")"; shift ;;
            --config-open-closed-groups) [[ $# -ge 2 ]] || usage_error "Missing value for --config-open-closed-groups"; CONFIG_OPEN_CLOSED_GROUPS_PATH="$(trim "$2")"; shift ;;
            help|version|key|profile|contact|private-group|open-group|closed-group|public-channel|post|event|timestamp|self-test)
                TOP_COMMAND="$1"
                shift
                COMMAND_REST=("$@")
                log_debug "Found TOP_COMMAND: $TOP_COMMAND"
                return 0
                ;;
            --) shift; break ;;
            *) usage_error "Unknown global option: $1" ;;
        esac
        shift
    done
    COMMAND_REST=("$@")
    log_debug "Exiting parse_global_args"
}

parse_event_args() {
    log_debug "Entering parse_event_args"
    while (($#)); do
        case "$1" in
            -h|--help|help) SHOW_HELP=1; HELP_LEVEL="command"; return 0 ;;
            --nevent)
                [[ $# -ge 2 ]] || usage_error "Missing value for --nevent"
                NEVENTS+=("$2"); shift ;;
            *)
                if [[ "$1" == nostr:nevent1* || "$1" == nevent1* ]] || \
		[[ "$1" == nostr:naddr1* || "$1" == naddr1* ]]; then
                    NEVENTS+=("$1")
                else
                    usage_error "Unknown event option or invalid nevent: $1"
                fi
                ;;
        esac
        shift
    done
    log_debug "Exiting parse_event_args"
}

parse_timestamp_args() {
    log_debug "Entering parse_timestamp_args"
    while (($#)); do
        case "$1" in
            -h|--help|help) SHOW_HELP=1; HELP_LEVEL="command"; return 0 ;;
            --timestamp|-t) [[ $# -ge 2 ]] || usage_error "Missing value for --timestamp"; TIMESTAMP_VALUE="$2"; shift ;;
            *)
                if [[ -z "$TIMESTAMP_VALUE" ]]; then
                    TIMESTAMP_VALUE="$1"
                else
                    usage_error "Unknown timestamp option or multiple values provided: $1"
                fi
                ;;
        esac
        shift
    done
    log_debug "Exiting parse_timestamp_args"
}

