cmd_profile_set() {
    log_debug "Executing profile set"
    require_nsec
    require_relays
    log_debug "Building profile JSON"
    local profile_json
    profile_json=$(jq -nc \
        --arg name "${PROFILE_NAME}" \
        --arg about "${PROFILE_ABOUT}" \
        --arg picture "${PROFILE_PICTURE}" \
        --arg nip05 "${PROFILE_NIP05}" \
        --arg lud16 "${PROFILE_LUD16}" \
        --arg display_name "${PROFILE_DISPLAY_NAME}" \
        --arg website "${PROFILE_WEBSITE}" \
        --arg banner "${PROFILE_BANNER}" \
        '{name:$name, about:$about, picture:$picture, nip05:$nip05, lud16:$lud16, display_name:$display_name, website:$website, banner:$banner} | with_entries(select(.value != ""))')
    log_debug "Profile JSON: $profile_json"
    local stderr_file output status=0 err_output
    stderr_file=$(mktemp)
    output=$(nak event --sec "$NSEC" -k 0 -c "$profile_json" "${RELAYS[@]}" 2>"$stderr_file") || status=$?
    err_output=$(<"$stderr_file")
    rm -f "$stderr_file"
    if [[ $status -ne 0 ]]; then
        log_err "nak event (kind 0) failed (exit $status)"
        if [[ -n "$err_output" ]]; then
            printf '%b[ERROR] nak stderr: %s%b\n' "$COLOR_RED" "$err_output" "$COLOR_RESET" >&2
        fi
        exit "$EXIT_ERROR"
    fi
    log_debug "Profile publish output: $output"
    if [[ $JSON -eq 1 ]]; then
        printf '{"status":"published","kind":0}\n'
    else
        printf '%bProfile (kind 0) published to %d relay(s)%b\n' "$COLOR_GREEN" "${#RELAYS[@]}" "$COLOR_RESET"
    fi
    exit "$EXIT_OK"
}

cmd_profile_get() {
    log_debug "Executing profile get"
    require_relays
    local limit="${LIMIT:-$DEFAULT_GET_LIMIT}"
    if (( limit > MAX_GET_LIMIT )); then
        usage_error "--limit $limit exceeds MAX_GET_LIMIT ($MAX_GET_LIMIT). Edit source code to increase."
    fi
    local -a nak_args=("req" "-k" "0")
    if (( limit > 0 )); then
        nak_args+=("--limit" "$limit")
    fi
    if [[ -n "$SINCE" ]]; then nak_args+=("--since" "$SINCE"); fi
    if [[ -n "$UNTIL" ]]; then nak_args+=("--until" "$UNTIL"); fi
    for relay in "${RELAYS[@]}"; do
        nak_args+=("$relay")
    done
    if [[ ${#NPUBS[@]} -gt 0 ]]; then
        log_debug "Filtering profile get by ${#NPUBS[@]} npub(s)"
        for npub_val in "${NPUBS[@]}"; do
            local hex
            if ! hex=$(resolve_token_to_hex "$npub_val"); then
                log_err "Failed to resolve npub to hex: $npub_val"
                exit "$EXIT_ERROR"
            fi
            nak_args+=("-a" "$hex")
            log_debug "Added author filter: $hex"
        done
    else
        log_debug "No --npub filter; fetching profiles for all contacts"
        if [[ ${#CONFIG_CONTACTS[@]} -eq 0 ]]; then
            log_err "No contacts configured and no --npub specified. Add contacts to contacts.sh or use --npub."
            exit "$EXIT_ERROR"
        fi
        local -a contact_hexes=()
        while IFS= read -r hex_line; do
            [[ -n "$hex_line" ]] && contact_hexes+=("$hex_line")
        done < <(resolve_all_contacts_to_hex)
        if [[ ${#contact_hexes[@]} -eq 0 ]]; then
            log_err "Failed to resolve any contacts to public hex."
            exit "$EXIT_ERROR"
        fi
        for hex in "${contact_hexes[@]}"; do
            nak_args+=("-a" "$hex")
            log_debug "Added contact author filter: $hex"
        done
    fi
    local output
    if ! output=$(run_nak_full nak "${nak_args[@]}"); then
        exit "$EXIT_ERROR"
    fi
    if [[ $JSON -eq 1 ]]; then
        printf '%s\n' "$output"
    else
        if [[ -z "$output" ]]; then
            printf 'No profiles found.\n'
        else
            local first=1
            printf '%s\n' "$output" | while IFS= read -r line; do
                local pubkey content_json
                pubkey=$(printf '%s' "$line" | jq -r '.pubkey // empty' 2>/dev/null)
                content_json=$(printf '%s' "$line" | jq -c '.content | fromjson' 2>/dev/null)
                [[ -z "$content_json" || "$content_json" == "null" ]] && content_json="{}"
                local name display_name about gender area picture banner nip05 lud16
                name=$(printf '%s' "$content_json" | jq -r '.name // empty' 2>/dev/null)
                display_name=$(printf '%s' "$content_json" | jq -r '.display_name // empty' 2>/dev/null)
