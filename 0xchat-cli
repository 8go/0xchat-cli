cmd_contact_send() {
    log_debug "Executing contact send"
    require_nsec
    require_npub
    require_text
    require_relays
    local -a all_messages=()
    for t in "${TEXTS[@]}"; do
        if [[ "$t" == "-" ]]; then
            all_messages+=("$(cat)")
        else
            all_messages+=("$t")
        fi
    done
    for f in "${TEXT_FILES[@]}"; do
        [[ -f "$f" ]] || fail "Text file not found: $f"
        all_messages+=("$(cat "$f")")
    done

    local self_hex
    self_hex=$(run_nak nak key public "$NSEC") || exit "$EXIT_ERROR"

    local -a target_hexes=()
    local -a seen_hexes=()

    # NIP-17 Compliance: Sender MUST receive a copy to view in their own client
    target_hexes+=("$self_hex")
    seen_hexes+=("$self_hex")

    local total_sent=0
    local total_failed=0

    for recipient_npub in "${NPUBS[@]}"; do
        local recipient_hex
        recipient_hex=$(run_nak nak decode "$recipient_npub") || { log_err "Failed to decode recipient: $recipient_npub"; total_failed=$((total_failed + ${#all_messages[@]})); continue; }
        local dup=0
        for s in "${seen_hexes[@]}"; do
            [[ "$s" == "$recipient_hex" ]] && { dup=1; break; }
        done
        if [[ $dup -eq 0 ]]; then
            target_hexes+=("$recipient_hex")
            seen_hexes+=("$recipient_hex")
        fi
    done

    log_debug "Sending ${#all_messages[@]} message(s) to ${#target_hexes[@]} target(s) (including sender)"

    # Build inner p-tags for the Kind 14 event (all participants)
    local -a inner_p_args=()
    for phex in "${seen_hexes[@]}"; do
        inner_p_args+=("-p" "$phex")
    done

    for target_hex in "${target_hexes[@]}"; do
        for msg_text in "${all_messages[@]}"; do
            log_debug "Wrapping DM for target $(nsec_short "$target_hex")"
            local kind14_event
	    local -a nak_args=("event" "--sec" "$NSEC" "-k" "14" "-c" "$msg_text" "-p" "${target_hex}")
            if ! kind14_event=$(run_nak_full nak "${nak_args[@]}"); then
		log_err "cmd_contact_send: Failed to create kind 14 event"
		total_failed=$((total_failed + 1))
		continue
	    fi
            local wrapped
            local wrap_stderr; wrap_stderr=$(mktemp)
            # NSEC = sender
            log_debug "Inner Kind 14, before being wrapped: $kind14_event"
            # Outer wrap targets the specific person who can decrypt it (uses ephemeral key)
            local -a nak_args=("gift" "wrap" "--sec" "$NSEC" "-p" "${target_hex}")
            log_debug "cmd_contact_send: running nak: echo '$kind14_event' | nak $(sanitize_args_for_log ${nak_args[@]})"
            wrapped=$(printf '%s' "$kind14_event" | nak "${nak_args[@]}" 2>"$wrap_stderr")
            local wrap_status=$?
            local wrap_err; wrap_err=$(<"$wrap_stderr"); rm -f "$wrap_stderr"
            if [[ $wrap_status -ne 0 ]]; then
                log_err "Gift wrap failed for recipient $(nsec_short "$recipient_npub"): $wrap_err"
                total_failed=$((total_failed + 1))
                continue
            fi
            local stderr_file; stderr_file=$(mktemp)
            local pub_out
            log_debug "cmd_contact_send: running nak: echo '$wrapped' | nak event ${RELAYS[@]}"
            pub_out=$(printf '%s' "$wrapped" | nak event "${RELAYS[@]}" 2>"$stderr_file")
            local pub_status=$?
            local err_output; err_output=$(<"$stderr_file"); rm -f "$stderr_file"
	    # err_output always contains something, even on success it coaintains: ...connecting ... ok.
	    if [[ "$err_output" == *"failed"* ]]; then
		log_err "Publish failed for recipient $(nsec_short "$recipient_npub"): $err_output"
                total_failed=$((total_failed + 1))
                continue
	    fi
            if [[ $pub_status -ne 0 ]]; then
                log_err "Publish failed for recipient $(nsec_short "$recipient_npub"): $err_output"
                total_failed=$((total_failed + 1))
                continue
            fi
            total_sent=$((total_sent + 1))
            log_debug "DM sent to $(nsec_short "$recipient_npub"): $pub_out"
        done
    done
    if [[ $JSON -eq 1 ]]; then
        printf '{"sent":%d,"failed":%d,"recipients":%d,"messages":%d}\n' "$total_sent" "$total_failed" "${#target_hexes[@]}" "${#all_messages[@]}"
    else
        if [[ $total_failed -gt 0 ]]; then
            printf '%bSent %d DM(s) (%d failed) to %d recipient(s) (includes copy(ies) to sender)%b\n' "$COLOR_RED" "$total_sent" "$total_failed" "${#target_hexes[@]}" "$COLOR_RESET"
        else
            printf '%bSent %d DM(s) to %d recipient(s) (includes copy(ies) to sender)%b\n' "$COLOR_GREEN" "$total_sent" "${#target_hexes[@]}" "$COLOR_RESET"
        fi
    fi
    [[ $total_failed -gt 0 ]] && exit "$EXIT_ERROR"
    exit "$EXIT_OK"
}

