    printf 'Running self-test 4: key generate... ' >&2
    local test4_output
    test4_output=$( JSON=0 cmd_key_generate 2>"$stderr_file" )
    local test4_status=$?
    if [[ $test4_status -eq 0 && -n "$test4_output" ]]; then
        printf '%bPASSED%b\n' "$COLOR_GREEN" "$COLOR_RESET" >&2
        passed_tests=$((passed_tests + 1))
    else
        printf '%bFAILED%b\n' "$COLOR_RED" "$COLOR_RESET" >&2
        log_err "  Expected: non-empty output and exit 0"
        log_err "  Got:      ${test4_output:-<empty>} (exit $test4_status)"
        [[ -s "$stderr_file" ]] && log_err "  Stderr: $(cat "$stderr_file")"
        failed_tests=$((failed_tests + 1))
    fi

    total_tests=$((total_tests + 1))
    printf 'Running self-test 5: key roundtrip (generate+derive+convert)... ' >&2
    local gen_output
    gen_output=$( JSON=1 DEBUG=$DEBUG cmd_key_generate 2>"$stderr_file" )
    log_debug "generated key: " $gen_output
    local gen_status=$?
    if [[ $gen_status -eq 0 && -n "$gen_output" ]]; then
        local gen_nsec gen_public_hex gen_npub
        gen_nsec=$(printf '%s' "$gen_output" | jq -r '.nsec // empty')
        gen_public_hex=$(printf '%s' "$gen_output" | jq -r '.public_hex // empty')
        gen_npub=$(printf '%s' "$gen_output" | jq -r '.npub // empty')

        if [[ -n "$gen_nsec" && -n "$gen_public_hex" && -n "$gen_npub" ]]; then
            local derived_hex
            derived_hex=$(
                NSEC="$gen_nsec"
                JSON=0
                DEBUG="$DEBUG"
                cmd_key_derive_public_hex 2>"$stderr_file"
            )
            local converted_hex
            converted_hex=$(
                NPUBS=("$gen_npub")
                JSON=0
                DEBUG="$DEBUG"
                cmd_key_convert_npub_to_hex 2>"$stderr_file"
            )
            log_debug "converted_hex $converted_hex , "  $(cat "$stderr_file")
            if [[ "$derived_hex" == "$gen_public_hex" && "$converted_hex" == "$gen_public_hex" ]]; then
                printf '%bPASSED%b\n' "$COLOR_GREEN" "$COLOR_RESET" >&2
                passed_tests=$((passed_tests + 1))
            else
                printf '%bFAILED%b\n' "$COLOR_RED" "$COLOR_RESET" >&2
                log_err "  Generated public_hex: $gen_public_hex"
                log_err "  Derived public_hex:   ${derived_hex:-<empty>}"
                log_err "  Converted from npub:  ${converted_hex:-<empty>}"
                failed_tests=$((failed_tests + 1))
            fi
        else
            printf '%bFAILED%b\n' "$COLOR_RED" "$COLOR_RESET" >&2
            log_err "  Could not parse generate JSON output: $gen_output"
            failed_tests=$((failed_tests + 1))
        fi
    else
        printf '%bFAILED%b\n' "$COLOR_RED" "$COLOR_RESET" >&2
        log_err "  key generate failed (exit $gen_status)"
        [[ -s "$stderr_file" ]] && log_err "  Stderr: $(cat "$stderr_file")"
        failed_tests=$((failed_tests + 1))
    fi

    total_tests=$((total_tests + 1))
    printf 'Running self-test 6: --nsec private hex acceptance... ' >&2
    local test6_nsec=""
    test6_nsec=$(resolve_identity_token "$test_private_hex" 2>"$stderr_file")
    local test6_status=$?
    if [[ $test6_status -eq 0 && "$test6_nsec" == "$test_nsec" ]]; then
        printf '%bPASSED%b\n' "$COLOR_GREEN" "$COLOR_RESET" >&2
        passed_tests=$((passed_tests + 1))
    else
        printf '%bFAILED%b\n' "$COLOR_RED" "$COLOR_RESET" >&2
        log_err "  Expected: $test_nsec"
        log_err "  Got:      ${test6_nsec:-<empty>} (exit $test6_status)"
        failed_tests=$((failed_tests + 1))
    fi

    if [[ ${#RELAYS[@]} -gt 0 ]]; then
        total_tests=$((total_tests + 1))
        printf 'Running self-test 7: profile set+get roundtrip... ' >&2
        local pname="0xchat-cli-selftest-$$"
        local ps_out
        ps_out=$( NSEC="$test_nsec" PROFILE_NAME="$pname" JSON=1 cmd_profile_set 2>"$stderr_file" )
        local ps_status=$?
        if [[ $ps_status -eq 0 ]]; then
            sleep 2
            local pg_out
            pg_out=$(
                NPUBS=("$test_public_hex")
                LIMIT="3"
                JSON=1
                cmd_profile_get 2>"$stderr_file"
            )
            local pg_status=$?
            if [[ $pg_status -eq 0 ]] && printf '%s' "$pg_out" | grep -qF "$pname"; then
                printf '%bPASSED%b\n' "$COLOR_GREEN" "$COLOR_RESET" >&2
                passed_tests=$((passed_tests + 1))
            else
                printf '%bFAILED%b\n' "$COLOR_RED" "$COLOR_RESET" >&2
                log_err "  Profile set succeeded but get did not find name: $pname"
                log_err "  Get output: ${pg_out:-<empty>} (exit $pg_status)"
                [[ -s "$stderr_file" ]] && log_err "  Stderr: $(cat "$stderr_file")"
                failed_tests=$((failed_tests + 1))
            fi
        else
            printf '%bFAILED%b\n' "$COLOR_RED" "$COLOR_RESET" >&2
            log_err "  profile set failed (exit $ps_status)"
            [[ -s "$stderr_file" ]] && log_err "  Stderr: $(cat "$stderr_file")"
            failed_tests=$((failed_tests + 1))
        fi
    else
        total_tests=$((total_tests + 1))
        printf 'Running self-test 7: profile set+get roundtrip... SKIPPED (no relays)\n' >&2
    fi

    rm -f "$stderr_file"
    echo "" >&2
    if [[ $failed_tests -eq 0 ]]; then
        printf '%b%d of %d tests succeeded%b\n' "$COLOR_GREEN" "$passed_tests" "$total_tests" "$COLOR_RESET" >&2
    else
        printf '%b%d of %d tests succeeded%b\n' "$COLOR_GREEN" "$passed_tests" "$total_tests" "$COLOR_RESET" >&2
        printf '%b%d self-tests failed%b\n' "$COLOR_RED" "$failed_tests" "$COLOR_RESET" >&2
        exit "$EXIT_ERROR"
    fi
    exit "$EXIT_OK"
}

# ==============================================================================
# Dispatch & Main
# ==============================================================================

dispatch() {
    local cmd="${1:-}"
    shift || true
    log_debug "Entering dispatch with cmd: $cmd"
    case "$cmd" in
        help) print_help_top ;;
        version) printf '%s %s\n' "$SCRIPT_NAME" "$SCRIPT_VERSION" ;;
        event)
            parse_event_args "$@"
            if [[ $SHOW_HELP -eq 1 ]]; then
                print_help_event
                return 0
            fi
            cmd_event
            ;;
        timestamp)
            parse_timestamp_args "$@"
            if [[ $SHOW_HELP -eq 1 ]]; then
                print_help_timestamp
                return 0
            fi
            cmd_timestamp
            ;;
        self-test)
            for arg in "$@"; do
                if [[ "$arg" == "-h" || "$arg" == "--help" || "$arg" == "help" ]]; then
                    SHOW_HELP=1
                    break
                fi
            done
            [[ $SHOW_HELP -eq 1 ]] && { print_help_self_test; return 0; }
            run_self_test
            ;;
        key)
            parse_key_args "$@"
            if [[ $SHOW_HELP -eq 1 ]]; then
                if [[ "$HELP_LEVEL" == "verb" ]]; then $HELP_FUNC; else print_help_key; fi
                return 0
            fi
            case "$VERB" in
                generate) cmd_key_generate ;;
                convert-nsec-to-hex) require_nsec; cmd_key_convert_nsec_to_hex ;;
                convert-npub-to-hex) require_npub; cmd_key_convert_npub_to_hex ;;
                convert-hex-to-nsec) require_hex; cmd_key_convert_hex_to_nsec ;;
                convert-hex-to-npub) require_hex; cmd_key_convert_hex_to_npub ;;
                derive-npub) require_nsec; cmd_key_derive_npub ;;
                derive-public-hex) require_nsec; cmd_key_derive_public_hex ;;
            esac
            ;;
        profile)
            parse_profile_args "$@"
            if [[ $SHOW_HELP -eq 1 ]]; then
                if [[ "$HELP_LEVEL" == "verb" ]]; then $HELP_FUNC; else print_help_profile; fi
                return 0
            fi
            case "$VERB" in
                get) cmd_profile_get ;;
                set) cmd_profile_set ;;
            esac
            ;;
        contact)
            parse_contact_args "$@"
            if [[ $SHOW_HELP -eq 1 ]]; then
                if [[ "$HELP_LEVEL" == "verb" ]]; then $HELP_FUNC; else print_help_contact; fi
                return 0
            fi
            case "$VERB" in
                send) cmd_contact_send ;;
                get) cmd_contact_get ;;
                listen) cmd_contact_listen ;;
            esac
            ;;
        private-group)
            parse_group_args private-group "$@"
            if [[ $SHOW_HELP -eq 1 ]]; then
                if [[ "$HELP_LEVEL" == "verb" ]]; then
                    $HELP_FUNC
                else
                    print_help_private_group
                fi
                return 0
            fi
            case "$VERB" in
                send) cmd_private_group_send ;;
                get) cmd_private_group_get ;;
                listen) cmd_private_group_listen ;;
            esac
            ;;
        open-group|closed-group)
            parse_nip29_args "$cmd" "$@"
            if [[ $SHOW_HELP -eq 1 ]]; then
                if [[ "$HELP_LEVEL" == "verb" ]]; then
                    $HELP_FUNC "$cmd"
                else
                    print_help_nip29 "$cmd"
                fi
                return 0
            fi
            case "$VERB" in
                send) cmd_nip29_send "${cmd%-group}" ;;
                get) cmd_nip29_get "${cmd%-group}" ;;
                listen) cmd_nip29_listen "${cmd%-group}" ;;
            esac
            ;;
        public-channel)
            parse_public_channel_args "$@"
            if [[ $SHOW_HELP -eq 1 ]]; then
                if [[ "$HELP_LEVEL" == "verb" ]]; then
                    $HELP_FUNC
                else
                    print_help_public_channel
                fi
                return 0
            fi
            case "$VERB" in
                send) cmd_public_channel_send ;;
                get) cmd_public_channel_get ;;
                listen) cmd_public_channel_listen ;;
            esac
            ;;
        post)
            parse_post_args "$@"
            if [[ $SHOW_HELP -eq 1 ]]; then
                if [[ "$HELP_LEVEL" == "verb" ]]; then $HELP_FUNC; else print_help_post; fi
                return 0
            fi
            case "$VERB" in
                send) cmd_post_send ;;
                get) cmd_post_get ;;
                listen) cmd_post_listen ;;
            esac
            ;;
        "")
            print_help_top
            ;;
        *)
            usage_error "Unknown command: ${cmd:-<none>}"
            ;;
    esac
    log_debug "Exiting dispatch"
}

main() {
    log_debug "========= Starting main ========="
    setup_colors
    require_bash4_if_needed
    parse_global_args "$@"
    [[ $SHOW_HELP -eq 1 ]] && { print_help_top; return 0; }
    [[ $SHOW_VERSION -eq 1 ]] && { printf '%s %s\n' "$SCRIPT_NAME" "$SCRIPT_VERSION"; return 0; }
    if [[ -z "$TOP_COMMAND" ]]; then
        print_help_top
        return 0
    fi
    validate_explicit_configs
    load_configs
    if [[ "$TOP_COMMAND" != "help" && "$TOP_COMMAND" != "version" ]]; then
        check_dependencies
    fi
    if [[ ${#COMMAND_REST[@]} -eq 0 ]]; then
        if [[ "$TOP_COMMAND" == "help" ]]; then
            print_help_top
            return 0
        elif [[ "$TOP_COMMAND" == "version" ]]; then
            printf '%s %s\n' "$SCRIPT_NAME" "$SCRIPT_VERSION"
            return 0
        elif [[ "$TOP_COMMAND" == "self-test" ]]; then
            dispatch "$TOP_COMMAND"
            return 0
        else
            dispatch "$TOP_COMMAND" "--help"
            return 0
        fi
    fi
    dispatch "$TOP_COMMAND" "${COMMAND_REST[@]}"
    log_debug "========= Exiting main ========="
}

main "$@"
