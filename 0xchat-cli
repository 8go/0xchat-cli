                picture=$(printf '%s' "$content_json" | jq -r '.picture // empty' 2>/dev/null)
                banner=$(printf '%s' "$content_json" | jq -r '.banner // empty' 2>/dev/null)
                nip05=$(printf '%s' "$content_json" | jq -r '.nip05 // empty' 2>/dev/null)
                lud16=$(printf '%s' "$content_json" | jq -r '.lud16 // empty' 2>/dev/null)
                local effective_name="${name:-${display_name:-<unnamed>}}"
                local npub_val=""
                [[ -n "$pubkey" ]] && npub_val=$(run_nak nak encode npub "$pubkey" 2>/dev/null)
                local alias_label=""
                [[ -n "$pubkey" ]] && alias_label=$(lookup_alias_for_hex "$pubkey" 2>/dev/null) || alias_label=""
                if [[ $first -eq 1 ]]; then
                    first=0
                else
                    printf '%s\n' '----------------------------------------'
                fi
                printf 'ALIAS:       %s\n' "${alias_label:-<none>}"
                printf 'NPUB:        %s\n' "${npub_val:-<unknown>}"
                printf 'PUBLIC-HEX:  %s\n' "${pubkey:-<unknown>}"
                printf 'name:        %s\n' "$effective_name"
                printf 'about:       %s\n' "$about"
                printf 'gender:      %s\n' "$gender"
                printf 'area:        %s\n' "$area"
                printf 'picture:     %s\n' "$picture"
                printf 'banner:      %s\n' "$banner"
                printf 'nip05:       %s\n' "$nip05"
                printf 'lud16:       %s\n' "$lud16"
            done
        fi
    fi
    exit "$EXIT_OK"
}

