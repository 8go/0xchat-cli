cmd_post_send() {
    log_debug "Executing post send"
    require_nsec
    require_text
    require_relays
    local message_text=""
    if [[ ${#TEXTS[@]} -gt 0 ]]; then
        message_text="${TEXTS[0]}"
        if [[ "$message_text" == "-" ]]; then
            message_text="$(cat)"
        fi
    elif [[ ${#TEXT_FILES[@]} -gt 0 ]]; then
        if [[ ! -f "${TEXT_FILES[0]}" ]]; then
            fail "Text file not found: ${TEXT_FILES[0]}"
        fi
        message_text=$(cat "${TEXT_FILES[0]}")
    fi
    log_debug "Post text length: ${#message_text}"
    log_debug "Publishing to ${#RELAYS[@]} relay(s)"
    local stderr_file
    stderr_file=$(mktemp)
    local output
    local status=0
    output=$(printf '%s' "$message_text" | nak publish --sec "$NSEC" "${RELAYS[@]}" 2>"$stderr_file") || status=$?
    local err_output
    err_output=$(<"$stderr_file")
    rm -f "$stderr_file"
    if [[ $status -ne 0 ]]; then
        log_err "nak publish failed (exit $status)"
        if [[ -n "$err_output" ]]; then
            printf '%b[ERROR] nak stderr: %s%b\n' "$COLOR_RED" "$err_output" "$COLOR_RESET" >&2
        fi
        exit "$EXIT_ERROR"
    fi
    log_debug "Publish output: $output"
    local event_id=""
    event_id=$(printf '%s\n' "$output" | grep -oE '"id":"[^"]+"' | head -1 | cut -d'"' -f4)
    if [[ $JSON -eq 1 ]]; then
        printf '{"status":"published","event_id":"%s","relays":%d}\n' "${event_id:-unknown}" "${#RELAYS[@]}"
    else
        if [[ -n "$event_id" ]]; then
            printf '%bPublished event: %s%b\n' "$COLOR_GREEN" "$event_id" "$COLOR_RESET"
        else
            printf '%bPublished successfully to %d relay(s)%b\n' "$COLOR_GREEN" "${#RELAYS[@]}" "$COLOR_RESET"
        fi
    fi
    exit "$EXIT_OK"
}

_fetch_posts() {
    local req_since="$1"
    local req_until="$2"
    local req_limit="$3"
    LAST_FETCH_COUNT=0
    require_relays
    local -a nak_args=("req" "-k" "1")
    local effective_limit="${req_limit:-$DEFAULT_GET_LIMIT}"
    if (( effective_limit > MAX_GET_LIMIT )); then
        usage_error "--limit $effective_limit exceeds MAX_GET_LIMIT ($MAX_GET_LIMIT). Edit source code to increase."
    fi
    if (( effective_limit > 0 )); then
        nak_args+=("--limit" "$effective_limit")
    fi
    if [[ -n "$req_since" ]]; then nak_args+=("--since" "$req_since"); fi
    if [[ -n "$req_until" ]]; then nak_args+=("--until" "$req_until"); fi
    for relay in "${RELAYS[@]}"; do nak_args+=("$relay"); done
    if [[ ${#NPUBS[@]} -gt 0 ]]; then
        for npub_val in "${NPUBS[@]}"; do
            local hex
            if ! hex=$(resolve_token_to_hex "$npub_val"); then
                log_err "Failed to resolve npub to hex: $npub_val"
