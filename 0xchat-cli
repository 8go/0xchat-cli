# ==============================================================================
# Implementations: NIP-29 Groups (Open/Closed)
# ==============================================================================

cmd_nip29_send() {
    local group_type="$1"
    require_nsec
    require_text
    log_debug "cmd_nip29_send: group_type is $group_type"
    if [[ "$group_type" == "closed" ]]; then
        log_debug "For send, get and listen there is NO difference between an open-group and a closed-group. Both are NIP-29, both send, get, listen the same. The difference is in how they are joining the group. Anyone can join an open group unilaterally, joining a closed group requires approval or invitation."
    fi
    # NIP29_GROUP_IDS is an array that already has items like: open|123...group-id...abc|wss://groups.0xchat.com
    # It has gone through resolve_nip29_group() already and is its output.
    if [[ ${#NIP29_GROUP_IDS[@]} -eq 0 ]]; then usage_error "--group-id is required"; fi
    local -a resolved_gids=()
    local -a resolved_relays=()
    for res in "${NIP29_GROUP_IDS[@]}"; do
        log_debug "cmd_nip29_send: sending to resolved group $res"
        local IFS='|'; read -ra parts <<< "$res"
        local res_gid="${parts[1]}"
        local res_relay="${parts[2]}"
        if [[ -z "$res_relay" ]]; then
            if [[ -z "$NIP29_RELAY" ]]; then usage_error "Group '$res_gid' not found in config or missing relay, and no --relay provided."; fi
            res_relay="$NIP29_RELAY"
        fi
        resolved_gids+=("$res_gid")
        resolved_relays+=("$res_relay")
    done
    log_debug "cmd_nip29_send: sending to these gids (group-ids): ( ${resolved_gids[@]} )"
    log_debug "cmd_nip29_send: sending to these relays (urls): ( ${resolved_relays[@]} )"
    local -a all_messages=()
    for t in "${TEXTS[@]}"; do
        if [[ "$t" == "-" ]]; then all_messages+=("$(cat)"); else all_messages+=("$t"); fi
    done
    for f in "${TEXT_FILES[@]}"; do
        [[ -f "$f" ]] || fail "Text file not found: $f"
        all_messages+=("$(cat "$f")")
    done
    local total_sent=0
    local total_failed=0
    for i in "${!resolved_gids[@]}"; do
        local gid="${resolved_gids[$i]}"
        local relay="${resolved_relays[$i]}"
        for msg in "${all_messages[@]}"; do
            local stderr_file; stderr_file=$(mktemp)
            local output; local status=0
            # NIP-29 group messages use Kind 9 with 'h' tag
	    local -a nak_args=("event" "--sec" "$NSEC" "-k" "9" "-t" "h=$gid" "-c" "$msg" "$relay")
            if ! output=$(run_nak_full nak "${nak_args[@]}"); then
                log_err "Publish failed to group $gid on $relay."
                total_failed=$((total_failed + 1))
                continue
	    fi
            total_sent=$((total_sent + 1))
        done
    done
    if [[ $JSON -eq 1 ]]; then
        printf '{"sent":%d,"failed":%d,"groups":%d,"messages":%d}\n' "$total_sent" "$total_failed" "${#resolved_gids[@]}" "${#all_messages[@]}"
    else
        if [[ $total_failed -gt 0 ]]; then
            printf '%bSent %d message(s) (%d failed) to %d group(s)%b\n' "$COLOR_RED" "$total_sent" "$total_failed" "${#resolved_gids[@]}" "$COLOR_RESET"
        else
            printf '%bSent %d message(s) to %d group(s)%b\n' "$COLOR_GREEN" "$total_sent" "${#resolved_gids[@]}" "$COLOR_RESET"
        fi
    fi
    [[ $total_failed -gt 0 ]] && exit "$EXIT_ERROR"
    exit "$EXIT_OK"
}

_fetch_nip29() {
    local group_type="$1"
    local gid="$2"
    local relay="$3"
    local req_since="$4"
    local req_until="$5"
    local req_limit="$6"
    LAST_FETCH_COUNT=0
    require_nsec
    if [[ "$group_type" == "closed" ]]; then
        log_debug "For send, get and listen there is NO difference between an open-group and a closed-group. Both are NIP-29, both send, get, listen the same. The difference is in how they are joining the group. Anyone can join an open group unilaterally, joining a closed group requires approval or invitation."
    fi
    # nak req -k 9 --auth --sec $NSEC  -h abc...group-id... -a "PUB-HEX-of-SENDER1..."  -a "PUB-HEX-of-SENDER1..."  wss://groups.0xchat.com
    # This worked. One can optionally filter by SENDER (-a) == author == pubkey; use zero or multiple -a
    # OPEN-GROUP GET with multiple --npub (sender)
    # NIP-29 group messages use Kind 9 with 'h' tag
    local -a nak_args=("req" "-k" "9" "--auth" "--sec" "$NSEC" "-t" "h=$gid")
    local effective_limit="${req_limit:-$DEFAULT_GET_LIMIT}"
    if (( effective_limit > MAX_GET_LIMIT )); then
        usage_error "--limit $effective_limit exceeds MAX_GET_LIMIT ($MAX_GET_LIMIT). Edit source code to increase."
    fi
    if (( effective_limit > 0 )); then
        nak_args+=("--limit" "$effective_limit")
    fi
    if [[ -n "$req_since" ]]; then nak_args+=("--since" "$req_since"); fi
    if [[ -n "$req_until" ]]; then nak_args+=("--until" "$req_until"); fi
    if [[ ${#NPUBS[@]} -gt 0 ]]; then
        log_debug "Filtering nip29 get by ${#NPUBS[@]} npub(s)"
        for npub_val in "${NPUBS[@]}"; do
            local hex
            if ! hex=$(resolve_token_to_hex "$npub_val"); then
                log_err "Failed to resolve npub to hex: $npub_val"
                return 1
            fi
            nak_args+=("-a" "$hex")
            log_debug "Added author (sender) filter: $hex"
        done
    fi
    nak_args+=("$relay")
    if ! output=$(run_nak_full nak "${nak_args[@]}"); then return 1; fi
    if [[ -z "$output" ]]; then
        if [[ $JSON -eq 1 ]]; then printf '[]\n'; else printf 'No messages found.\n'; fi
        return 0
    fi
    # Sort events chronologically (oldest to newest)
    output=$(printf '%s\n' "$output" | jq -sc 'sort_by(.created_at) | .[]' 2>/dev/null)
    log_debug "_fetch_nip29: sorted output is $output"
    LAST_FETCH_COUNT=$(printf '%s\n' "$output" | awk 'NF {c++} END {print c+0}')
    log_debug "_fetch_nip29: LAST_FETCH_COUNT is $LAST_FETCH_COUNT"
    printf '%s\n' "$output" | while IFS= read -r line; do
        log_debug "_fetch_nip29: fetched line is $line"
        [[ -z "$line" ]] && continue
        # Execute hook if provided (always gets raw JSON)
        if [[ -n "$EXEC_CMD" ]]; then
            _execute_hook "$line"
        fi
        if [[ $JSON -eq 1 ]]; then
            printf '%s\n' "$line"
        else
            local ts pubkey content date_str alias_label
            ts=$(printf '%s' "$line" | jq -r '.created_at // empty' 2>/dev/null)
            pubkey=$(printf '%s' "$line" | jq -r '.pubkey // empty' 2>/dev/null)
            content=$(printf '%s' "$line" | jq -r '.content // empty' 2>/dev/null)
            date_str=""
            if [[ -n "$ts" ]]; then
                date_str=$(date -d "@$ts" '+%Y-%m-%d %H:%M' 2>/dev/null || date -r "$ts" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s' "$ts")
            fi
            alias_label=$(format_sender_label "$pubkey")
            printf '[%s] [%s]: %s\n' "$date_str" "$alias_label" "$content"
        fi
    done
    return 0
}

_stream_nip29() {
    local group_type="$1"
    local gid="$2"
    local relay="$3"
    local req_since="$4"
    local req_until="$5"
    local req_limit="$6"
    require_nsec
    log_debug "_stream_nip29: relay is $relay"
    if [[ "$group_type" == "closed" ]]; then
        log_debug "For send, get and listen there is NO difference between an open-group and a closed-group. Both are NIP-29, both send, get, listen the same. The difference is in how they are joining the group. Anyone can join an open group unilaterally, joining a closed group requires approval or invitation."
    fi
    # don't set --limit and --until because they are defined differently for --listen in 0xchat-cli than in nak
    # nak req -k 9 --auth --sec $NSEC  -h abc...group-id... -a "PUB-HEX-of-SENDER1..."  -a "PUB-HEX-of-SENDER1..."  wss://groups.0xchat.com
    # This worked. One can optionally filter by SENDER (-a) == author == pubkey; use zero or multiple -a
    # OPEN-GROUP GET with multiple --npub (sender)
    local -a nak_args=("req" "-k" "9" "--auth" "--sec" "$NSEC" "-t" "h=$gid" "--stream")
    if [[ -n "$req_since" ]]; then nak_args+=("--since" "$req_since"); fi
    if [[ ${#NPUBS[@]} -gt 0 ]]; then
        log_debug "Filtering nip29 listen by ${#NPUBS[@]} npub(s)"
        for npub_val in "${NPUBS[@]}"; do
            local hex
            if ! hex=$(resolve_token_to_hex "$npub_val"); then
                log_err "Failed to resolve npub to hex: $npub_val"
                return 1
            fi
            nak_args+=("-a" "$hex")
            log_debug "Added author (sender) filter: $hex"
        done
    fi
    nak_args+=("$relay")
    local req_stderr; req_stderr=$(mktemp)
    log_debug "_stream_nip29: running nak $(sanitize_args_for_log ${nak_args[@]})"

    local count=0
    while true; do
        if IFS= read -t 1 -r line; then
	    if [ -z "$line:-" ]; then
		log_debug "_stream_nip29: found an empty line. unexpected."
		continue
	    fi
            if [[ -n "$EXEC_CMD" ]]; then _execute_hook "$line"; fi
            if [[ $JSON -eq 1 ]]; then
                printf '%s\n' "$line"
            else
                local ts pubkey content date_str alias_label
                ts=$(printf '%s' "$line" | jq -r '.created_at // empty' 2>/dev/null)
                pubkey=$(printf '%s' "$line" | jq -r '.pubkey // empty' 2>/dev/null)
                content=$(printf '%s' "$line" | jq -r '.content // empty' 2>/dev/null)
                date_str=""
                if [[ -n "$ts" ]]; then date_str=$(date -d "@$ts" '+%Y-%m-%d %H:%M' 2>/dev/null || date -r "$ts" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s' "$ts"); fi
                alias_label=$(format_sender_label "$pubkey")
                printf '[%s] [%s]: %s\n' "$date_str" "$alias_label" "$content"
            fi
            count=$((count + 1))
            if [[ -n "$req_limit" ]] && (( count >= req_limit )); then log_debug "Reached --limit of $req_limit"; break; fi
        else
            local rc=$?
            if [[ $rc -gt 128 ]]; then
                if [[ -n "$req_until" ]] && (( $(date +%s) >= req_until )); then log_debug "Reached --until time"; break; fi
                continue
            else
                break
            fi
        fi
    done < <(nak "${nak_args[@]}" 2>"$req_stderr")

    local err_output; err_output=$(<"$req_stderr"); rm -f "$req_stderr"
    if [[ -n "$err_output" ]]; then
      if [[ $(echo "$err_output" | wc -l) -eq 1 ]] && [[ "$err_output" =~ \.\.\.\ ok\.$ ]]; then
        log_debug "nak connected ok: $err_output"
      elif [[ $(echo "$err_output" | wc -l) -eq 2 ]] && [[ "$err_output" =~ \.\.\.\ ok\..*authenticating\ to\ .*\.\.\. ]]; then
        # connecting to groups.0xchat.com... ok.
        # authenticating to groups.0xchat.com as npub179…r2c3q...
        log_debug "nak connected ok, authenticated ok: $err_output"
      else
        printf '%b[ERROR] nak stderr: %s%b\n' "$COLOR_RED" "$err_output" "$COLOR_RESET" >&2
      fi
    fi
    return 0
}

cmd_nip29_get() {
    local group_type="$1"
    log_debug "cmd_nip29_get: group_type is $group_type"
    # NIP29_GROUP_IDS already has items like: open|123...group-id...abc|wss://groups.0xchat.com
    # It  has gone through resolve_nip29_group() already and is its output.
    if [[ ${#NIP29_GROUP_IDS[@]} -eq 0 ]]; then usage_error "--group-id is required"; fi
    if [[ ${#NIP29_GROUP_IDS[@]} -gt 1 ]]; then usage_error "--group-id can only be specified exactly once for get"; fi
    local res; res="${NIP29_GROUP_IDS[0]}"
    log_debug "cmd_nip29_get: resolved group is $res"
    local IFS='|'; read -ra parts <<< "$res"
    local res_gid="${parts[1]}"
    local res_relay="${parts[2]}"
    log_debug "cmd_nip29_get: resolve group info is $res, group-id is $res_gid, group relay is $res_relay"
    if [[ -z "$res_relay" ]]; then
        if [[ -z "$NIP29_RELAY" ]]; then usage_error "Group '$res_gid' not found in config or missing relay, and no --relay provided."; fi
        res_relay="$NIP29_RELAY"
    fi
    _fetch_nip29 "$group_type" "$res_gid" "$res_relay" "$SINCE" "$UNTIL" "$LIMIT" || exit "$EXIT_ERROR"
    exit "$EXIT_OK"
}

