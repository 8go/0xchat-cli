# ==============================================================================
# Implementations: Event
# ==============================================================================

_event_decode() {
# returns JSON object like this:
# {
#  "pubkey": "f1756..."
#  "kind": 39000,
#  "identifier": "c02d0...",
#  "relays": [
#    "wss://groups.0xchat.com"
#  ]
#}
        local decoded
        if decoded=$(run_nak_full nak decode "$1"); then
		printf '%s' "$decoded"
	else
		return 1
	fi
}

cmd_event() {
    if [[ ${#NEVENTS[@]} -eq 0 ]]; then
        usage_error "Missing --nevent argument"
    fi
    local first=1
    if [[ $JSON -eq 1 ]]; then printf '['; fi
    for nevent in "${NEVENTS[@]}"; do
        local decoded
        if decoded=$(_event_decode "$nevent"); then
            if [[ $JSON -eq 1 ]]; then
                [[ $first -eq 0 ]] && printf ','
                printf '%s' "$decoded"
                first=0
            else
                printf '%s\n' "$decoded"
            fi
        else
            log_err "Failed to decode: $nevent"
        fi
    done
    if [[ $JSON -eq 1 ]]; then printf ']\n'; fi
    exit "$EXIT_OK"
}

# ==============================================================================
# Implementations: Timestamp
# ==============================================================================

cmd_timestamp() {
    local input="$TIMESTAMP_VALUE"
    if [[ -z "$input" ]]; then
        usage_error "Missing timestamp value. Provide it as an argument (e.g., '1 hour ago' or 1779887279)."
    fi
    if [[ "$input" =~ ^[0-9]+$ ]]; then
        local len=${#input}
        local unix_ts="$input"
        if [[ $len -eq 13 ]]; then
            unix_ts="${input:0:10}"
        fi
        local human
        human=$(resolve_timestamp_to_human "$unix_ts")
        if [[ $JSON -eq 1 ]]; then
            printf '{"unix":%s,"human":"%s","input_type":"unix"}\n' "$unix_ts" "$human"
        else
            printf '%s (Unix: %s)\n' "$human" "$unix_ts"
        fi
    else
        local unix_ts
        if ! unix_ts=$(resolve_timestamp_to_unix "$input"); then
            exit "$EXIT_ERROR"
        fi
        local human
        human=$(resolve_timestamp_to_human "$unix_ts")
        if [[ $JSON -eq 1 ]]; then
            printf '{"unix":%s,"human":"%s","input_type":"human"}\n' "$unix_ts" "$human"
        else
            printf '%s (%s)\n' "$unix_ts" "$human"
        fi
    fi
    exit "$EXIT_OK"
}

