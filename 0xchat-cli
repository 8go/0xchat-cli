# Shared: Fetch & Unwrap (for contact get / private-group get)
# ==============================================================================

EXPECTED_GROUP_MEMBERS=()

_fetch_and_unwrap() {
    local mode="$1"
    local req_since="$2"
    local req_until="$3"
    local req_limit="$4"
    LAST_FETCH_COUNT=0
    require_nsec
    require_relays

    local self_hex
    self_hex=$(run_nak nak key public "$NSEC") || return 1

    # NIP-17 Timestamp Randomization Protection
    local relay_since="$req_since"
    if [[ ("$mode" == "contact" || "$mode" == "private-group") && -n "$relay_since" ]]; then
        relay_since=$(( relay_since - 172800 ))
        (( relay_since < 0 )) && relay_since=0
    fi

    local -a nak_args=("req" "-k" "1059" "-p" "$self_hex")
    local effective_limit="${req_limit:-$DEFAULT_GET_LIMIT}"
    if (( effective_limit > MAX_GET_LIMIT )); then
        usage_error "--limit $effective_limit exceeds MAX_GET_LIMIT ($MAX_GET_LIMIT). Edit source code to increase."
    fi
    if (( effective_limit > 0 )); then
        nak_args+=("--limit" "$effective_limit")
    fi
    if [[ -n "$relay_since" ]]; then nak_args+=("--since" "$relay_since"); fi
    if [[ -n "$req_until" ]]; then nak_args+=("--until" "$req_until"); fi

    for relay in "${RELAYS[@]}"; do nak_args+=("$relay"); done
    log_debug "_fetch_and_unwrap: Fetching kind 1059 events for self hex: $self_hex"
    log_debug "_fetch_and_unwrap: running nak $(sanitize_args_for_log ${nak_args[@]})"
    local req_stderr; req_stderr=$(mktemp)
    local req_stdout; req_stdout=$(mktemp)
    local unwrap_stderr; unwrap_stderr=$(mktemp)
    local unwrapped
    nak "${nak_args[@]}" >"$req_stdout" 2>"$req_stderr"
    local req_status=$?
    local req_err; req_err=$(<"$req_stderr")
    if [[ $req_status -ne 0 ]]; then
        log_err "nak req failed: $req_err"
        rm -f "$req_stderr" "$req_stdout" "$unwrap_stderr"
        return 1
    fi
    log_debug "wrapped NIP17 object: $(cat "$req_stdout")"
    unwrapped=$(nak gift unwrap --sec "$NSEC" <"$req_stdout" 2>"$unwrap_stderr")
    log_debug "unwrapped NIP17 object: $unwrapped"
    local unwrap_status=$?
    local unwrap_err; unwrap_err=$(<"$unwrap_stderr")
    rm -f "$req_stderr" "$req_stdout" "$unwrap_stderr"
    if [[ -n "$unwrap_err" ]]; then
        log_debug "nak gift unwrap produced stderr (some events may have been skipped or failed to decrypt): $unwrap_err"
    fi
    if [[ -z "$unwrapped" ]]; then
        if [[ $JSON -eq 1 ]]; then printf '[]\n'; else printf 'No messages found.\n'; fi
        return 0
    fi
    local jq_filter=""
    if [[ "$mode" == "contact" ]]; then
        jq_filter='select(([.tags[]? | select(.[0] == "subject")] | length) == 0)'
    elif [[ "$mode" == "private-group" ]]; then
        jq_filter='select(([.tags[]? | select(.[0] == "subject")] | length) > 0)'
        if [[ ${#EXPECTED_GROUP_MEMBERS[@]} -gt 0 ]]; then
            local hex_array=""
            for shex in "${EXPECTED_GROUP_MEMBERS[@]}"; do
                [[ -n "$hex_array" ]] && hex_array+=","
                hex_array+="\"$shex\""
            done
            jq_filter+=" | select(([.tags[]? | select(.[0] == \"p\") | .[1]] | sort) == ([${hex_array}] | sort))"
            jq_filter+=" | select(([.tags[]? | select(.[0] == \"p\")] | length) == ([${hex_array}] | length))"
        fi
    fi
    if [[ ${#NPUBS[@]} -gt 0 && "$mode" == "contact" ]]; then
        local -a sender_hexes=()
        for npub_val in "${NPUBS[@]}"; do
            local shex
            shex=$(resolve_token_to_hex "$npub_val") || { log_err "Failed to resolve sender: $npub_val"; return 1; }
            sender_hexes+=("$shex")
        done
        local hex_array=""
        for shex in "${sender_hexes[@]}"; do
            [[ -n "$hex_array" ]] && hex_array+=","
            hex_array+="\"$shex\""
        done
        jq_filter+=" | select(.pubkey as \$p | [$hex_array] | index(\$p) != null)"
    fi

    # Strict inner event time filtering (crucial for NIP-17)
    if [[ -n "$req_since" ]]; then jq_filter+=" | select(.created_at >= $req_since)"; fi
    if [[ -n "$req_until" ]]; then jq_filter+=" | select(.created_at <= $req_until)"; fi

    log_debug "Applying jq filter and sorting chronologically: $jq_filter"
    local filtered
    # Slurp into array, apply filter, sort by created_at, and unpack back to NDJSON
    filtered=$(printf '%s\n' "$unwrapped" | jq -c -s "[.[] | $jq_filter] | sort_by(.created_at) | .[]" 2>/dev/null)
    if [[ -z "$filtered" ]]; then
        if [[ $JSON -eq 1 ]]; then printf '[]\n'; else printf 'No matching messages found.\n'; fi
        return 0
    fi
    LAST_FETCH_COUNT=$(printf '%s\n' "$filtered" | awk 'NF {c++} END {print c+0}')
    # Use process substitution to preserve global SEEN_IDS array
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        local id
        id=$(printf '%s' "$line" | jq -r '.id // empty' 2>/dev/null)
        if [[ -n "$id" ]]; then
            if [[ -n "${SEEN_IDS[$id]:-}" ]]; then
                LAST_FETCH_COUNT=$((LAST_FETCH_COUNT - 1))
                continue
            fi
            SEEN_IDS["$id"]=1
        fi

        # Execute hook if provided (always gets raw JSON)
        if [[ -n "$EXEC_CMD" ]]; then _execute_hook "$line"; fi

        if [[ $JSON -eq 1 ]]; then
            printf '%s\n' "$line"
        else
            log_debug "Filtered object is: $line"
            local ts pubkey content subject alias_label
            ts=$(printf '%s' "$line" | jq -r '.created_at // empty' 2>/dev/null)
            pubkey=$(printf '%s' "$line" | jq -r '.pubkey // empty' 2>/dev/null)
            content=$(printf '%s' "$line" | jq -r '.content // empty' 2>/dev/null)
            subject=$(printf '%s' "$line" | jq -r '(.tags[]? | select(.[0] == "subject") | .[1]) // empty' 2>/dev/null)
            local date_str=""
            if [[ -n "$ts" ]]; then
                date_str=$(date -d "@$ts" '+%Y-%m-%d %H:%M' 2>/dev/null || date -r "$ts" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s' "$ts")
            fi
            alias_label=$(format_sender_label "$pubkey")
            if [[ "$mode" == "private-group" ]]; then
                if [[ -n "$PRIVATE_GROUP_NAME" && -n "$subject" && "$subject" != "$PRIVATE_GROUP_NAME" ]]; then
                    log_debug "Subject tag '$subject' does not match --group-name '$PRIVATE_GROUP_NAME'"
                    printf '%b[WARNING] Subject tag "%s" does not match --group-name "%s"%b\n' "$COLOR_YELLOW" "$subject" "$PRIVATE_GROUP_NAME" "$COLOR_RESET" >&2
                fi
                if [[ -n "$subject" ]]; then
                    printf '[%s] [%s] #%s: %s\n' "$date_str" "$alias_label" "$subject" "$content"
                else
                    printf '[%s] [%s]: %s\n' "$date_str" "$alias_label" "$content"
                fi
            else
                printf '[%s] [%s]: %s\n' "$date_str" "$alias_label" "$content"
            fi
        fi
    done < <(printf '%s\n' "$filtered")
    return 0
}

_stream_and_unwrap() {
    local mode="$1"
    local req_since="$2"
    local req_until="$3"
    local req_limit="$4"
    require_nsec
    require_relays

    local self_hex
    self_hex=$(run_nak nak key public "$NSEC") || return 1

    # don't set --limit and --until because they are defined differently for --listen in 0xchat-cli than in nak

    # NIP-17 Timestamp Randomization Protection
    local relay_since="$req_since"
    if [[ ("$mode" == "contact" || "$mode" == "private-group") && -n "$relay_since" ]]; then
        relay_since=$(( relay_since - 172800 ))
        (( relay_since < 0 )) && relay_since=0
    fi

    local -a nak_args=("req" "-k" "1059" "-p" "$self_hex" "--stream")
    if [[ -n "$relay_since" ]]; then nak_args+=("--since" "$relay_since"); fi
    for relay in "${RELAYS[@]}"; do nak_args+=("$relay"); done
    # Note: We DO NOT filter by sender pubkey with "nak -a xxx" because
    # the outer Kind 1059 event is signed by an ephemeral key, not the real sender.
    # We must filter by the real sender's pubkey AFTER decrypting the inner event.
    log_debug "Streaming kind 1059 events: nak ${nak_args[*]}"
    local req_stderr; req_stderr=$(mktemp)

    local count=0
    while true; do
        if IFS= read -t 1 -r line; then
            local unwrapped
            unwrapped=$(printf '%s' "$line" | nak gift unwrap --sec "$NSEC" 2>/dev/null)
            if [[ -z "$unwrapped" ]]; then continue; fi



        local jq_filter=""
        if [[ "$mode" == "contact" ]]; then
            jq_filter='select(([.tags[]? | select(.[0] == "subject")] | length) == 0)'
            if [[ ${#NPUBS[@]} -gt 0 ]]; then
                local hex_array=""
                for npub_val in "${NPUBS[@]}"; do
                    local shex
                    shex=$(resolve_token_to_hex "$npub_val" 2>/dev/null) || continue
                    [[ -n "$hex_array" ]] && hex_array+=","
                    hex_array+="\"$shex\""
                done
                if [[ -n "$hex_array" ]]; then
                    jq_filter+=" | select(.pubkey as \$p | [$hex_array] | index(\$p) != null)"
                fi
            fi
        elif [[ "$mode" == "private-group" ]]; then
                jq_filter='select(([.tags[]? | select(.[0] == "subject")] | length) > 0)'
                if [[ ${#EXPECTED_GROUP_MEMBERS[@]} -gt 0 ]]; then
                    local hex_array=""
                    for shex in "${EXPECTED_GROUP_MEMBERS[@]}"; do
                        [[ -n "$hex_array" ]] && hex_array+=","
                        hex_array+="\"$shex\""
                    done
                    jq_filter+=" | select(([.tags[]? | select(.[0] == \"p\") | .[1]] | sort) == ([${hex_array}] | sort))"
                    jq_filter+=" | select(([.tags[]? | select(.[0] == \"p\")] | length) == ([${hex_array}] | length))"
                fi
        fi

        # Strict inner event time filtering (crucial for NIP-17)
        if [[ -n "$req_since" ]]; then jq_filter+=" | select(.created_at >= $req_since)"; fi
        if [[ -n "$req_until" ]]; then jq_filter+=" | select(.created_at <= $req_until)"; fi

        local filtered
        filtered=$(printf '%s' "$unwrapped" | jq -c "$jq_filter" 2>/dev/null)
        if [[ -n "$filtered" ]]; then
            local id
            id=$(printf '%s' "$filtered" | jq -r '.id // empty' 2>/dev/null)
            if [[ -n "$id" ]]; then
                if [[ -n "${SEEN_IDS[$id]:-}" ]]; then continue; fi
                SEEN_IDS["$id"]=1
            fi

            if [[ -n "$EXEC_CMD" ]]; then _execute_hook "$filtered"; fi



                if [[ $JSON -eq 1 ]]; then
                    printf '%s\n' "$filtered"
                else
                    local ts pubkey content subject alias_label date_str
                    ts=$(printf '%s' "$filtered" | jq -r '.created_at // empty' 2>/dev/null)
                    pubkey=$(printf '%s' "$filtered" | jq -r '.pubkey // empty' 2>/dev/null)
                    content=$(printf '%s' "$filtered" | jq -r '.content // empty' 2>/dev/null)
                    subject=$(printf '%s' "$filtered" | jq -r '(.tags[]? | select(.[0] == "subject") | .[1]) // empty' 2>/dev/null)
                    date_str=""
                    if [[ -n "$ts" ]]; then date_str=$(date -d "@$ts" '+%Y-%m-%d %H:%M' 2>/dev/null || date -r "$ts" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s' "$ts"); fi
                    alias_label=$(format_sender_label "$pubkey")
                    if [[ "$mode" == "private-group" ]]; then
                        if [[ -n "$PRIVATE_GROUP_NAME" && -n "$subject" && "$subject" != "$PRIVATE_GROUP_NAME" ]]; then
                            printf '%b[WARNING] Subject tag "%s" does not match --group-name "%s"%b\n' "$COLOR_YELLOW" "$subject" "$PRIVATE_GROUP_NAME" "$COLOR_RESET" >&2
                        fi
                        if [[ -n "$subject" ]]; then
                            printf '[%s] [%s] #%s: %s\n' "$date_str" "$alias_label" "$subject" "$content"
                        else
                            printf '[%s] [%s]: %s\n' "$date_str" "$alias_label" "$content"
                        fi
                    else
                        printf '[%s] [%s]: %s\n' "$date_str" "$alias_label" "$content"
                    fi
                fi
                count=$((count + 1))
                if [[ -n "$req_limit" ]] && (( count >= req_limit )); then log_debug "Reached --limit of $req_limit"; break; fi
            fi
        else
            local rc=$?
            if [[ $rc -gt 128 ]]; then
                if [[ -n "$req_until" ]] && (( $(date +%s) >= req_until )); then log_debug "Reached --until time"; break; fi
                continue
            else
                break
            fi
        fi
    done < <(nak "${nak_args[@]}" 2>"$req_stderr")

    local err_output; err_output=$(<"$req_stderr"); rm -f "$req_stderr"
    if [[ -n "$err_output" ]]; then
      if [[ $(echo "$err_output" | wc -l) -eq 1 ]] && [[ "$err_output" =~ \.\.\.\ ok\.$ ]]; then
        log_debug "nak connected ok: $err_output"
      else
        printf '%b[ERROR] nak stderr: %s%b\n' "$COLOR_RED" "$err_output" "$COLOR_RESET" >&2
      fi
    fi
    return 0
}

# ==============================================================================
# NEW: Hook Execution Function (v0.32.0)
# ==============================================================================

# Executes the --exec command for a received message
# - Pipes raw JSON event to stdin
# - Sets OXCHATCLI_* environment variables for metadata
# - Runs in background (&) to avoid blocking the listener
_execute_hook() {
    local event_json="$1"
    [[ -z "$EXEC_CMD" || -z "$event_json" ]] && return 0

    # Extract metadata for environment variables
    local exec_kind exec_pubkey exec_npub exec_alias exec_content exec_created_at
    exec_kind=$(printf '%s' "$event_json" | jq -r '.kind // empty' 2>/dev/null)
    exec_pubkey=$(printf '%s' "$event_json" | jq -r '.pubkey // empty' 2>/dev/null)
    exec_content=$(printf '%s' "$event_json" | jq -r '.content // empty' 2>/dev/null)
    exec_created_at=$(printf '%s' "$event_json" | jq -r '.created_at // empty' 2>/dev/null)

    # Resolve npub and alias
    exec_npub=""
    [[ -n "$exec_pubkey" ]] && exec_npub=$(run_nak nak encode npub "$exec_pubkey" 2>/dev/null) || exec_npub=""
    exec_alias=$(lookup_alias_for_hex "$exec_pubkey" 2>/dev/null) || exec_alias=""

    # Execute the command in a subshell, piping the raw JSON to stdin
    # We use env to inject variables safely without polluting the main CLI environment
    # The & runs it in background so slow commands don't block the listener
    printf '%s\n' "$event_json" | env \
        OXCHATCLI_KIND="$exec_kind" \
        OXCHATCLI_PUBKEY="$exec_pubkey" \
        OXCHATCLI_NPUB_SENDER="$exec_npub" \
        OXCHATCLI_ALIAS="$exec_alias" \
        OXCHATCLI_CONTENT="$exec_content" \
        OXCHATCLI_GROUP_NAME="${PRIVATE_GROUP_NAME:-}" \
        OXCHATCLI_GROUP_ID="${NIP29_RESOLVED_GID:-}" \
        OXCHATCLI_CHANNEL_ID="${CHANNEL_IDS[0]:-}" \
        OXCHATCLI_CREATED_AT="$exec_created_at" \
        bash -c "$EXEC_CMD" 2>/dev/null &
}

# ==============================================================================
# Implementations: Contact Get / Private-Group Get & Listen Loops
# ==============================================================================

cmd_contact_get() {
    log_debug "Executing contact get"
    _fetch_and_unwrap "contact" "$SINCE" "$UNTIL" "$LIMIT" || exit "$EXIT_ERROR"
    exit "$EXIT_OK"
}

cmd_private_group_get() {
    log_debug "Executing private-group get"
    require_nsec
    require_private_group_name
    require_relays

    # Resolve members using new consolidated logic
    local -a group_members=()
    while IFS= read -r m; do
        [[ -n "$m" ]] && group_members+=("$m")
    done < <(resolve_private_group_members "$PRIVATE_GROUP_NAME") || exit "$EXIT_ERROR"

    # Build EXPECTED_GROUP_MEMBERS for jq filtering
    EXPECTED_GROUP_MEMBERS=()
    for npub_val in "${group_members[@]}"; do
        local rhex
        rhex=$(resolve_token_to_hex "$npub_val") || { log_err "Failed to resolve member: $npub_val"; exit "$EXIT_ERROR"; }
        EXPECTED_GROUP_MEMBERS+=("$rhex")
    done

    # Deduplicate
    local -a unique_expected=()
    for m in "${EXPECTED_GROUP_MEMBERS[@]}"; do
        local dup=0
        for u in "${unique_expected[@]}"; do [[ "$u" == "$m" ]] && { dup=1; break; }; done
        [[ $dup -eq 0 ]] && unique_expected+=("$m")
    done
    EXPECTED_GROUP_MEMBERS=("${unique_expected[@]}")

    _fetch_and_unwrap "private-group" "$SINCE" "$UNTIL" "$LIMIT" || exit "$EXIT_ERROR"
    exit "$EXIT_OK"
}

_listen_loop() {
    local mode="$1"
    if [[ "$mode" == "private-group" ]]; then
        require_nsec
        require_private_group_name
        require_relays

        local -a group_members=()
        while IFS= read -r m; do
            [[ -n "$m" ]] && group_members+=("$m")
        done < <(resolve_private_group_members "$PRIVATE_GROUP_NAME") || exit "$EXIT_ERROR"

        EXPECTED_GROUP_MEMBERS=()
        for npub_val in "${group_members[@]}"; do
            local rhex
            rhex=$(resolve_token_to_hex "$npub_val") || { log_err "Failed to resolve member: $npub_val"; exit "$EXIT_ERROR"; }
            EXPECTED_GROUP_MEMBERS+=("$rhex")
        done
        local -a unique_expected=()
        for m in "${EXPECTED_GROUP_MEMBERS[@]}"; do
            local dup=0
            for u in "${unique_expected[@]}"; do [[ "$u" == "$m" ]] && { dup=1; break; }; done
            [[ $dup -eq 0 ]] && unique_expected+=("$m")
        done
        EXPECTED_GROUP_MEMBERS=("${unique_expected[@]}")
    elif [[ "$mode" == "contact" ]]; then
        require_nsec
        require_relays
    elif [[ "$mode" == "post" ]]; then
        require_relays
    elif [[ "$mode" == "public-channel" ]]; then
        require_relays
        if [[ ${#CHANNEL_IDS[@]} -eq 0 ]]; then usage_error "--channel-id is required for public-channel listen"; fi
        if [[ ${#CHANNEL_IDS[@]} -gt 1 ]]; then usage_error "--channel-id can only be specified exactly once for public-channel listen"; fi
    elif [[ "$mode" == "open-group" || "$mode" == "closed-group" ]]; then
        require_relays
        # NIP29_GROUP_IDS already has items like: open|123...group-id...abc|wss://groups.0xchat.com
        # It has gone through resolve_nip29_group() already and is its output.
        if [[ ${#NIP29_GROUP_IDS[@]} -eq 0 ]]; then usage_error "--group-id is required for ${mode} listen"; fi
        if [[ ${#NIP29_GROUP_IDS[@]} -gt 1 ]]; then usage_error "--group-id can only be specified exactly once for ${mode} listen"; fi
        local res; res="${NIP29_GROUP_IDS[0]}"
        log_debug "_listen_loop: resolved group is $res"
        local IFS='|'; read -ra parts <<< "$res"
        local NIP29_RESOLVED_TYPE="${parts[0]}"
        local NIP29_RESOLVED_GID="${parts[1]}"
        local NIP29_RESOLVED_RELAY="${parts[2]}"
        log_debug "_listen_loop: resolve group info: $NIP29_RESOLVED_TYPE, $NIP29_RESOLVED_GID, $NIP29_RESOLVED_RELAY"
        if [[ -z "$NIP29_RESOLVED_RELAY" ]]; then
            if [[ -z "$NIP29_RELAY" ]]; then usage_error "Group '$NIP29_RESOLVED_GID' not found in config or missing relay, and no --relay provided."; fi
            NIP29_RESOLVED_RELAY="$NIP29_RELAY"
        fi
    fi

    local user_since="$SINCE"
    local user_until="$UNTIL"
    local user_limit="$LIMIT"

    # in order to sort the streaming we break the listen into 2 parts:
    # Phase 1: backfilling without --stream --> sorting
    # Phase 2: streaming the future with --stream --> we don't do any sorting but assume it is sorted as it is coming in real-time

    # PHASE 1: Chronological Backfill (if --since is provided)
    if [[ -n "$user_since" ]]; then
        printf '%bBackfilling old %s messages...%b\n' "$COLOR_GREEN" "$mode" "$COLOR_RESET" >&2
        log_debug "Performing chronological backfill from $user_since"
        if [[ "$mode" == "post" ]]; then
            _fetch_posts "$user_since" "$user_until" "$user_limit" || exit "$EXIT_ERROR"
        elif [[ "$mode" == "public-channel" ]]; then
            _fetch_channel "${CHANNEL_IDS[0]}" "$user_since" "$user_until" "$user_limit" || exit "$EXIT_ERROR"
        elif [[ "$mode" == "open-group" || "$mode" == "closed-group" ]]; then
            _fetch_nip29 "$NIP29_RESOLVED_TYPE" "$NIP29_RESOLVED_GID" "$NIP29_RESOLVED_RELAY" "$user_since" "$user_until" "$user_limit" || exit "$EXIT_ERROR"
        else
            _fetch_and_unwrap "$mode" "$user_since" "$user_until" "$user_limit" || exit "$EXIT_ERROR"
        fi

        # If the user specified a limit and we already reached it during backfill, we are done.
        if [[ -n "$user_limit" ]] && (( LAST_FETCH_COUNT >= user_limit )); then
            log_debug "Reached --limit of $user_limit during backfill. Exiting."
            exit "$EXIT_OK"
        fi

        # If the user specified an --until time that is already in the past, we are done.
        if [[ -n "$user_until" ]] && (( user_until < $(date +%s) )); then
            log_debug "Reached --until time during backfill. Exiting."
            exit "$EXIT_OK"
        fi

        # Update since to "now" so the live stream doesn't repeat the backfilled events
        user_since=$(date +%s)
        log_debug "Backfill complete. Transitioning to live stream from $user_since"
    else
        log_debug "No Backfilling of old $mode messages needed."
        # No backfill requested, default to "now"
        user_since=$(date +%s)
        log_debug "Defaulting --since to now ($user_since) for live stream"
    fi

    # PHASE 2: Live Real-Time Streaming
    printf '%bListening for new %s messages in real-time... (Press Ctrl+C to stop)%b\n' "$COLOR_GREEN" "$mode" "$COLOR_RESET" >&2
    trap 'printf "\n%bShutting down listener gracefully...%b\n" "$COLOR_YELLOW" "$COLOR_RESET" >&2; exit "$EXIT_OK"' INT TERM

    # Adjust limit for the stream if a limit was provided and partially consumed during backfill
    local stream_limit="$user_limit"
    if [[ -n "$user_limit" ]]; then
        stream_limit=$(( user_limit - LAST_FETCH_COUNT ))
    fi

    if [[ "$mode" == "post" ]]; then
        _stream_posts "$user_since" "$user_until" "$stream_limit" || exit "$EXIT_ERROR"
    elif [[ "$mode" == "public-channel" ]]; then
        _stream_channel "${CHANNEL_IDS[0]}" "$user_since" "$user_until" "$stream_limit" || exit "$EXIT_ERROR"
    elif [[ "$mode" == "open-group" || "$mode" == "closed-group" ]]; then
        _stream_nip29 "$NIP29_RESOLVED_TYPE" "$NIP29_RESOLVED_GID" "$NIP29_RESOLVED_RELAY" "$user_since" "$user_until" "$stream_limit" || exit "$EXIT_ERROR"
    else
        _stream_and_unwrap "$mode" "$user_since" "$user_until" "$stream_limit" || exit "$EXIT_ERROR"
    fi

    trap - INT TERM
    printf '%bListening complete.%b\n' "$COLOR_GREEN" "$COLOR_RESET" >&2
    exit "$EXIT_OK"
}

cmd_contact_listen() {
    log_debug "Executing contact listen"
    _listen_loop "contact"
}

cmd_private_group_listen() {
    log_debug "Executing private-group listen"
    _listen_loop "private-group"
}

