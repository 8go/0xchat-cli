# Resolves group members based on config presence and CLI args
# Enforces mutual exclusivity: config-driven vs CLI-driven
resolve_private_group_members() {
    local group_name="$1"
    local pg_file="${CONFIG_PRIVATE_GROUPS_PATH:-$DEFAULT_CONFIG_DIR/private-groups.sh}"
    local -a members=()

    if [[ -f "$pg_file" && ${#CONFIG_PRIVATE_GROUPS[@]} -gt 0 ]]; then
        # Config file present: --group-name required, --npub forbidden
        [[ -z "$group_name" ]] && usage_error "--group-name is required when private-groups config exists."
        [[ ${#NPUBS[@]} -gt 0 ]] && usage_error "--npub is forbidden when private-groups config exists. Define members in the config file."

        local members_str="${CONFIG_PRIVATE_GROUPS[$group_name]:-}"
        [[ -z "$members_str" ]] && usage_error "Group '$group_name' not found in private-groups config. Available: ${!CONFIG_PRIVATE_GROUPS[*]}"

        # Unify delimiters: replace pipes with newlines
        members_str="${members_str//|/$'\n'}"

        local -a temp_members=()
        # Read line-by-line to preserve spaces in aliases like "Bob Smith"
        while IFS= read -r line; do
            line="$(trim "$line")"
            [[ -n "$line" ]] && temp_members+=("$line")
        done <<< "$members_str"

        for m in "${temp_members[@]}"; do
            local resolved
            resolved=$(resolve_npub_token "$m") || { log_err "Failed to resolve group member: $m"; return 1; }
            members+=("$resolved")
        done
    else
        # No config file: --group-name required, --npub allowed
        [[ -z "$group_name" ]] && usage_error "--group-name is required."
        for n in "${NPUBS[@]}"; do
            local resolved
            resolved=$(resolve_npub_token "$n") || { log_err "Failed to resolve group member: $n"; return 1; }
            members+=("$resolved")
        done
    fi

    # Always add sender's npub (derived from active nsec), avoiding duplicates
    local self_hex
    self_hex=$(run_nak nak key public "$NSEC") || { log_err "Failed to derive pubkey from nsec"; return 1; }

    local has_sender=false
    for m in "${members[@]}"; do
        local mhex
        mhex=$(run_nak nak decode "$m" 2>/dev/null) || continue
        [[ "$mhex" == "$self_hex" ]] && has_sender=true && break
    done
    if [[ "$has_sender" == false ]]; then
        local self_npub
        self_npub=$(run_nak nak encode npub "$self_hex") || { log_err "Failed to encode self npub"; return 1; }
        members+=("$self_npub")
    fi

    # Deduplicate
    printf '%s\n' "${members[@]}" | sort -u
}

cmd_private_group_send() {
    log_debug "Executing private-group send"
    require_nsec
    require_text
    require_relays
    require_private_group_name

    # Resolve members using new consolidated logic
    local -a group_members=()
    while IFS= read -r m; do
        [[ -n "$m" ]] && group_members+=("$m")
    done < <(resolve_private_group_members "$PRIVATE_GROUP_NAME") || exit "$EXIT_ERROR"

    if [[ ${#group_members[@]} -eq 0 ]]; then
        usage_error "No group members resolved for group '$PRIVATE_GROUP_NAME'"
    fi

    local -a all_messages=()
    for t in "${TEXTS[@]}"; do
        if [[ "$t" == "-" ]]; then
            all_messages+=("$(cat)")
        else
            all_messages+=("$t")
        fi
    done
    for f in "${TEXT_FILES[@]}"; do
        [[ -f "$f" ]] || fail "Text file not found: $f"
        all_messages+=("$(cat "$f")")
    done

    log_debug "Sending ${#all_messages[@]} message(s) to ${#group_members[@]} member(s) in group '${PRIVATE_GROUP_NAME}'"

    local self_hex
    self_hex=$(run_nak nak key public "$NSEC") || exit "$EXIT_ERROR"

    local -a group_pubkeys=()
    local -a seen_hexes=()
    for npub_val in "${group_members[@]}"; do
        local rhex
        rhex=$(resolve_token_to_hex "$npub_val") || { log_err "Failed to resolve member: $npub_val"; exit "$EXIT_ERROR"; }
        local dup=0
        for s in "${seen_hexes[@]}"; do
            [[ "$s" == "$rhex" ]] && { dup=1; break; }
        done
        if [[ $dup -eq 0 ]]; then
            group_pubkeys+=("$rhex")
            seen_hexes+=("$rhex")
        fi
    done

    log_debug "Group has ${#group_pubkeys[@]} unique member(s)"

    local -a p_args=()
    for phex in "${group_pubkeys[@]}"; do
        p_args+=("-p" "$phex")
    done

    local total_sent=0
    local total_failed=0
    for msg_text in "${all_messages[@]}"; do
        log_debug "Processing message ${total_sent}+${total_failed}+1 of ${#all_messages[@]}"
        local kind14_event
        if ! kind14_event=$(run_nak_full nak event --kind 14 --content "$msg_text" --sec "$NSEC" \
            "${p_args[@]}" --tag "subject=${PRIVATE_GROUP_NAME}"); then
            log_err "Failed to create kind-14 event"
            total_failed=$((total_failed + ${#group_pubkeys[@]}))
            continue
        fi
        log_debug "kind14_event before wrapping: $kind14_event"
        for member_hex in "${group_pubkeys[@]}"; do
            log_debug "Wrapping for member $(nsec_short "$member_hex")"
            local wrapped
            local wrap_stderr; wrap_stderr=$(mktemp)
            wrapped=$(printf '%s' "$kind14_event" | nak gift wrap --sec "$NSEC" \
                --recipient-pubkey "$member_hex" 2>"$wrap_stderr")
            local wrap_status=$?
            local wrap_err; wrap_err=$(<"$wrap_stderr"); rm -f "$wrap_stderr"
            if [[ $wrap_status -ne 0 || -z "$wrapped" ]]; then
                log_err "Gift wrap failed for member $(nsec_short "$member_hex"): $wrap_err"
                total_failed=$((total_failed + 1))
                continue
            fi
            local pub_stderr; pub_stderr=$(mktemp)
            local pub_out
            pub_out=$(printf '%s' "$wrapped" | nak event "${RELAYS[@]}" 2>"$pub_stderr")
            local pub_status=$?
            local pub_err; pub_err=$(<"$pub_stderr"); rm -f "$pub_stderr"
            if [[ $pub_status -ne 0 ]]; then
                log_err "Publish failed for member $(nsec_short "$member_hex"): $pub_err"
                total_failed=$((total_failed + 1))
                continue
            fi
            total_sent=$((total_sent + 1))
            log_debug "Sent to member $(nsec_short "$member_hex"): $pub_out"
        done
    done
    if [[ $JSON -eq 1 ]]; then
        printf '{"sent":%d,"failed":%d,"members":%d,"messages":%d,"group":"%s"}\n' \
            "$total_sent" "$total_failed" "${#group_pubkeys[@]}" "${#all_messages[@]}" "$PRIVATE_GROUP_NAME"
    else
        if [[ $total_failed -gt 0 ]]; then
            printf '%bSent %d wrapped message(s) (%d failed) to %d member(s) in group "%s"%b\n' \
                "$COLOR_RED" "$total_sent" "$total_failed" "${#group_pubkeys[@]}" "$PRIVATE_GROUP_NAME" "$COLOR_RESET"
        else
            printf '%bSent %d wrapped message(s) to %d member(s) in group "%s"%b\n' \
                "$COLOR_GREEN" "$total_sent" "${#group_pubkeys[@]}" "$PRIVATE_GROUP_NAME" "$COLOR_RESET"
        fi
    fi
    [[ $total_failed -gt 0 ]] && exit "$EXIT_ERROR"
    exit "$EXIT_OK"
}

