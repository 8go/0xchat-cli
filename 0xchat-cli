        log_err "  Expected: $test_nsec"
        log_err "  Got:      ${test2_output:-<empty>} (exit $test2_status)"
        [[ -s "$stderr_file" ]] && log_err "  Stderr: $(cat "$stderr_file")"
        failed_tests=$((failed_tests + 1))
