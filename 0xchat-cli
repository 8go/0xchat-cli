cmd_key_generate() {
    log_debug "Executing key generate"
    local private_hex
    if ! private_hex=$(run_nak nak key generate); then
        exit "$EXIT_ERROR"
    fi
    log_debug "Generated private hex (truncated): $(nsec_short "$private_hex")"
    local nsec
    if ! nsec=$(run_nak nak encode nsec "$private_hex"); then
        exit "$EXIT_ERROR"
    fi
    log_debug "Encoded nsec: $(nsec_short "$nsec")"
    local public_hex
    if ! public_hex=$(run_nak nak key public "$private_hex"); then
        exit "$EXIT_ERROR"
    fi
    log_debug "Derived public hex: $public_hex"
    local npub
    if ! npub=$(run_nak nak encode npub "$public_hex"); then
        exit "$EXIT_ERROR"
    fi
    log_debug "Encoded npub: $npub"
    if [[ $JSON -eq 1 ]]; then
        printf '{"nsec":"%s","private_hex":"%s","npub":"%s","public_hex":"%s"}\n' "$nsec" "$private_hex" "$npub" "$public_hex"
    else
        printf 'nsec:        %s\n' "$nsec"
        printf 'private_hex: %s\n' "$private_hex"
        printf 'npub:        %s\n' "$npub"
        printf 'public_hex:  %s\n' "$public_hex"
    fi
    exit "$EXIT_OK"
}

